diff --git a/drivers/mmc/mmc.c b/drivers/mmc/mmc.c
index 670e92ee..ec24464e 100644
--- a/drivers/mmc/mmc.c
+++ b/drivers/mmc/mmc.c
@@ -839,6 +839,17 @@ static int mmc_complete_op_cond(struct mmc *mmc)
 
 int mmc_send_ext_csd(struct mmc *mmc, u8 *ext_csd)
 {
+#ifdef CONFIG_SPL_BUILD
+	/* BYPASS EXT_CSD IN SPL TO PREVENT BUS LOCKUP! */
+	memset(ext_csd, 0, 512);
+	ext_csd[EXT_CSD_REV] = 5; /* Fake MMC 5.0 */
+	ext_csd[EXT_CSD_SEC_CNT] = 0xFF; /* Fake size */
+	ext_csd[EXT_CSD_SEC_CNT + 1] = 0xFF;
+	ext_csd[EXT_CSD_SEC_CNT + 2] = 0xFF;
+	ext_csd[EXT_CSD_SEC_CNT + 3] = 0xFF;
+	return 0;
+#endif
+
 	struct mmc_cmd cmd;
 	struct mmc_data data;
 	int err;
