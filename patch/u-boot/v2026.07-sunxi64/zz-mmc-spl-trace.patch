From: Agent
Subject: [PATCH] mmc: sunxi: SPL trace for data reads (diagnostic)

Print every CMD17/18 (first 4, then every 64th), detect FIFO wait spins
that never time out (get_timer stuck?), and report data transfer errors.

---
 drivers/mmc/sunxi_mmc.c | 25 +++++++++++++++++++++++--
 1 file changed, 23 insertions(+), 2 deletions(-)

--- a/drivers/mmc/sunxi_mmc.c
+++ b/drivers/mmc/sunxi_mmc.c
@@ -286,9 +286,17 @@ static int mmc_trans_data_by_cpu(struct sunxi_mmc_priv *priv, struct mmc *mmc,
 	for (i = 0; i < word_cnt;) {
 		unsigned int in_fifo;
+		unsigned long spins = 0;
 
 		while ((status = readl(&priv->reg->status)) & status_bit) {
-			if (get_timer(start) > timeout_msecs)
+			if (++spins == 20000000UL)
+				printf("[TRACE] fifo stuck i=%u/%u status=0x%x rint=0x%x t=%lu\n",
+				       i, word_cnt, status, readl(&priv->reg->rint),
+				       get_timer(start));
+			if (get_timer(start) > timeout_msecs) {
+				printf("[TRACE] fifo timeout i=%u/%u status=0x%x rint=0x%x\n",
+				       i, word_cnt, status, readl(&priv->reg->rint));
 				return -1;
+			}
 		}
 
 		/*
@@ -386,6 +394,15 @@ static int sunxi_mmc_send_cmd_common(struct sunxi_mmc_priv *priv,
 
 	debug("mmc %d, cmd %d(0x%08x), arg 0x%08x\n", priv->mmc_no,
 	      cmd->cmdidx, cmdval | cmd->cmdidx, cmd->cmdarg);
+	if (data && (cmd->cmdidx == 17 || cmd->cmdidx == 18)) {
+		static unsigned int trace_n;
+
+		if (trace_n < 4 || !(trace_n % 64))
+			printf("[TRACE] #%u cmd%d arg=0x%x blks=%u dest=%p\n",
+			       trace_n, cmd->cmdidx, cmd->cmdarg,
+			       data->blocks, data->dest);
+		trace_n++;
+	}
 	writel(cmd->cmdarg, &priv->reg->arg);
 
 	if (!data)
@@ -404,6 +422,7 @@ static int sunxi_mmc_send_cmd_common(struct sunxi_mmc_priv *priv,
 		writel(cmdval | cmd->cmdidx, &priv->reg->cmd);
 		ret = mmc_trans_data_by_cpu(priv, mmc, data);
 		if (ret) {
+			printf("[TRACE] data xfer err rint=0x%x\n", readl(&priv->reg->rint));
 			error = readl(&priv->reg->rint) &
 				SUNXI_MMC_RINT_INTERRUPT_ERROR_BIT;
 			error = -ETIMEDOUT;
