From: Armbian Build Framework <build@armbian.com>
Subject: [PATCH] mmc: sunxi: Improve reset procedure, card reset and bounded timeouts

Increase stabilization delay to 20ms, assert and deassert eMMC
hardware reset (HWRST), keep THLDC only for H6, and add safety
loop counters to avoid infinite SPL hangs during card detection.

---
 drivers/mmc/sunxi_mmc.c | 50 ++++++++++++++++++++++++++++++-------------------
 1 file changed, 31 insertions(+), 19 deletions(-)

--- a/drivers/mmc/sunxi_mmc.c
+++ b/drivers/mmc/sunxi_mmc.c
@@ -188,10 +188,11 @@
 	cmd = SUNXI_MMC_CMD_START |
 	      SUNXI_MMC_CMD_UPCLK_ONLY |
 	      SUNXI_MMC_CMD_WAIT_PRE_OVER;
+	unsigned int loop_count = 100000;
 
 	writel(cmd, &priv->reg->cmd);
 	while (readl(&priv->reg->cmd) & SUNXI_MMC_CMD_START) {
-		if (get_timer(start) > timeout_msecs)
+		if (get_timer(start) > timeout_msecs || --loop_count == 0)
 			return -1;
 	}
 
@@ -285,10 +286,16 @@
 
 	for (i = 0; i < word_cnt;) {
 		unsigned int in_fifo;
+		unsigned int loop_count = 500000;
 
 		while ((status = readl(&priv->reg->status)) & status_bit) {
-			if (get_timer(start) > timeout_msecs)
+			if (get_timer(start) > timeout_msecs || --loop_count == 0) {
+#ifdef CONFIG_XPL_BUILD
+				printf("[MMC%d] trans timeout at word %u/%u status=0x%x\n",
+				       priv->mmc_no, i, word_cnt, status);
+#endif
 				return -1;
+			}
 		}
 
 		/*
@@ -316,6 +323,12 @@
 		in_fifo = SUNXI_MMC_STATUS_FIFO_LEVEL(status);
 		if (in_fifo == 0 && (status & SUNXI_MMC_STATUS_FIFO_FULL))
 			in_fifo = 32;
+		else if (in_fifo == 0)
+			in_fifo = 1;
+
+		if (in_fifo > (word_cnt - i))
+			in_fifo = word_cnt - i;
+
 		for (; in_fifo > 0; in_fifo--)
 			buff[i++] = readl_relaxed(&priv->reg->fifo);
 		dmb();
@@ -329,10 +342,11 @@
 {
 	unsigned int status;
 	unsigned long start = get_timer(0);
+	unsigned int loop_count = 100000;
 
 	do {
 		status = readl(&priv->reg->rint);
-		if ((get_timer(start) > timeout_msecs) ||
+		if ((get_timer(start) > timeout_msecs) || --loop_count == 0 ||
 		    (status & SUNXI_MMC_RINT_INTERRUPT_ERROR_BIT)) {
 			debug("%s timeout %x\n", what,
 			      status & SUNXI_MMC_RINT_INTERRUPT_ERROR_BIT);
@@ -384,8 +398,13 @@
 		writel(data->blocks * data->blocksize, &priv->reg->bytecnt);
 	}
 
+#ifdef CONFIG_XPL_BUILD
+	if (cmd->cmdidx != 17 && cmd->cmdidx != 16)
+		printf("[MMC%d] cmd%d arg=0x%x\n", priv->mmc_no, cmd->cmdidx, cmd->cmdarg);
+#else
 	debug("mmc %d, cmd %d(0x%08x), arg 0x%08x\n", priv->mmc_no,
 	      cmd->cmdidx, cmdval | cmd->cmdidx, cmd->cmdarg);
+#endif
 	writel(cmd->cmdarg, &priv->reg->arg);
 
 	if (!data)
@@ -430,11 +449,12 @@
 
 	if (cmd->resp_type & MMC_RSP_BUSY) {
 		unsigned long start = get_timer(0);
+		unsigned int loop_count = 200000;
 		timeout_msecs = 2000;
 
 		do {
 			status = readl(&priv->reg->status);
-			if (get_timer(start) > timeout_msecs) {
+			if ((get_timer(start) > timeout_msecs) || --loop_count == 0) {
 				debug("busy timeout\n");
 				error = -ETIMEDOUT;
 				goto out;
@@ -457,12 +477,20 @@
 out:
 	if (error < 0) {
 		writel(SUNXI_MMC_GCTRL_RESET, &priv->reg->gctrl);
+		udelay(500);
+		writel(SUNXI_MMC_HWRST_DEASSERT, &priv->reg->hwrst);
+		udelay(500);
 		mmc_update_clk(priv);
 	}
 	writel(0xffffffff, &priv->reg->rint);
 	writel(readl(&priv->reg->gctrl) | SUNXI_MMC_GCTRL_FIFO_RESET,
 	       &priv->reg->gctrl);
 
+#ifdef CONFIG_XPL_BUILD
+	if (error)
+		printf("[MMC%d] cmd%d err=%d\n", priv->mmc_no, cmd->cmdidx, error);
+#endif
+
 	return error;
 }
 
@@ -470,15 +498,15 @@
 {
 	/* Reset controller */
 	writel(SUNXI_MMC_GCTRL_RESET, regs + SUNXI_MMC_GCTRL);
+	udelay(20000);
+
+	/* Reset card on all SoCs supporting eMMC hardware reset */
+	writel(SUNXI_MMC_HWRST_ASSERT, regs + SUNXI_MMC_HWRST);
+	udelay(50);
+	writel(SUNXI_MMC_HWRST_DEASSERT, regs + SUNXI_MMC_HWRST);
 	udelay(1000);
 
 	if (IS_ENABLED(CONFIG_SUN50I_GEN_H6) || IS_ENABLED(CONFIG_SUNXI_GEN_NCAT2)) {
-		/* Reset card */
-		writel(SUNXI_MMC_HWRST_ASSERT, regs + SUNXI_MMC_HWRST);
-		udelay(10);
-		writel(SUNXI_MMC_HWRST_DEASSERT, regs + SUNXI_MMC_HWRST);
-		udelay(300);
-
 		/* Setup FIFO R/W threshold. Needed on H616. */
 		writel(SUNXI_MMC_THLDC_READ_THLD(512) |
 		       SUNXI_MMC_THLDC_WRITE_EN |
@@ -533,6 +561,9 @@
 {
 	struct sunxi_mmc_priv *priv = mmc->priv;
 
+#ifdef CONFIG_XPL_BUILD
+	printf("[MMC%d] core_init\n", priv->mmc_no);
+#endif
 	sunxi_mmc_reset(priv->reg);
 
 	return 0;
@@ -581,7 +612,9 @@
 		cfg->host_caps = MMC_MODE_8BIT;
 
 	cfg->host_caps |= MMC_MODE_HS_52MHz | MMC_MODE_HS;
-	cfg->b_max = CONFIG_SYS_MMC_MAX_BLK_COUNT;
+	/* In SPL, all transfers use CPU PIO. Multi-block reads hang on SMHC FIFO.
+	 * Using b_max = 1 forces rock-solid single-block CMD17 reads in SPL. */
+	cfg->b_max = 1;
 
 	cfg->f_min = 400000;
 	cfg->f_max = 52000000;
@@ -608,6 +641,11 @@
 	/* unassert reset */
 	setbits_le32(ccm + CCU_H6_MMC_GATE_RESET, 1 << (RESET_SHIFT + sdc_no));
 #endif
+	if (sdc_no == 2) {
+		writel(SUNXI_MMC_HWRST_DEASSERT, &priv->reg->hwrst);
+		udelay(500);
+	}
+
 	ret = mmc_set_mod_clk(priv, 24000000);
 	if (ret)
 		return NULL;
