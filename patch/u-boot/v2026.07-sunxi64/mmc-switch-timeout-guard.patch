From: Armbian Build Framework <build@armbian.com>
Subject: [PATCH] mmc: add bounded loop counters to prevent infinite hangs in SPL

---
 drivers/mmc/mmc.c | 11 +++++++++--
 1 file changed, 9 insertions(+), 2 deletions(-)

--- a/drivers/mmc/mmc.c
+++ b/drivers/mmc/mmc.c
@@ -779,7 +779,7 @@
 		if (mmc->ocr & OCR_BUSY)
 			break;
 
-		if (get_timer(start) > timeout)
+		if (get_timer(start) > timeout || i >= 10000)
 			return -ETIMEDOUT;
 		udelay(100);
 	}
@@ -796,6 +796,8 @@
 
 	mmc->op_cond_pending = 0;
 	if (!(mmc->ocr & OCR_BUSY)) {
+		int retries = 10000;
+
 		/* Some cards seem to need this */
 		mmc_go_idle(mmc);
 
@@ -806,7 +808,7 @@
 				return err;
 			if (mmc->ocr & OCR_BUSY)
 				break;
-			if (get_timer(start) > timeout)
+			if (get_timer(start) > timeout || --retries == 0)
 				return -EOPNOTSUPP;
 			udelay(100);
 		}
@@ -906,6 +908,8 @@
 	 * is false, because by now (after 'timeout_ms' ms) the bus should be
 	 * reliable.
 	 */
+	unsigned int switch_retries = timeout_ms * 20 + 2000;
+
 	do {
 		ret = mmc_send_status(mmc, &status);
 
@@ -917,6 +921,8 @@
 		if (!ret && (status & MMC_STATUS_RDY_FOR_DATA) &&
 		    (status & MMC_STATUS_CURR_STATE) == MMC_STATE_TRANS)
 			return 0;
+		if (--switch_retries == 0)
+			return -ETIMEDOUT;
 		udelay(100);
 	} while (get_timer(start) < timeout_ms);
 
