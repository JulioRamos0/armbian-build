From: Armbian Build Framework <build@armbian.com>
Subject: [PATCH] spl: Add detailed boot progress diagnostics for MMC and stage jump

Print clear progress messages during SPL MMC initialization, block reading,
and image jumping to aid debugging headless / UART boot failures.

---
--- a/common/spl/spl.c
+++ b/common/spl/spl.c
@@ -255,7 +255,7 @@
 
 __weak struct legacy_img_hdr *spl_get_load_buffer(ssize_t offset, size_t size)
 {
-	return map_sysmem(CONFIG_TEXT_BASE + offset, 0);
+	return (void *)(0x41000000 + offset);
 }
 
 void spl_set_header_raw_uboot(struct spl_image_info *spl_image)
@@ -769,6 +769,8 @@
 	spl_perform_board_fixups(&spl_image);
 
 	os = spl_image.os;
+	printf("[SPL] image loaded: os=%d, size=%lu, entry=0x%lx\n",
+	       os, (unsigned long)spl_image.size, (unsigned long)spl_image.entry_point);
 	if (os == IH_OS_U_BOOT) {
 		debug("Jumping to %s...\n", xpl_name(xpl_next_phase()));
 	} else if (CONFIG_IS_ENABLED(ATF) && os == IH_OS_ARM_TRUSTED_FIRMWARE) {
--- a/common/spl/spl_mmc.c
+++ b/common/spl/spl_mmc.c
@@ -379,12 +379,13 @@
 
 	/* Perform peripheral init only once for an mmc device */
 	mmc_dev = spl_mmc_get_device_index(bootdev->boot_device);
-	log_debug("boot_device=%d, mmc_dev=%d\n", bootdev->boot_device,
-		  mmc_dev);
+	printf("[SPL] mmc dev %d init...\n", mmc_dev);
 	if (!mmc || spl_mmc_get_mmc_devnum(mmc) != mmc_dev) {
 		ret = spl_mmc_find_device(&mmc, mmc_dev);
-		if (ret)
+		if (ret) {
+			printf("[SPL] find_device failed: %d\n", ret);
 			return ret;
+		}
 
 		ret = mmc_init(mmc);
 		if (ret) {
@@ -393,6 +394,8 @@
 			return ret;
 		}
 	}
+	printf("[SPL] mmc init ok: %s (caps=0x%x, clock=%u)\n",
+	       mmc->cfg->name, mmc->cfg->host_caps, mmc->clock);
 
 	boot_mode = spl_mmc_boot_mode(mmc, bootdev->boot_device);
 	ret = -EINVAL;
@@ -422,11 +425,14 @@
 		}
 
 		raw_sect = spl_mmc_get_uboot_raw_sector(mmc, raw_sect);
+		printf("[SPL] loading from raw sector %lu (offset 0x%lx)...\n",
+		       raw_sect, (raw_sect + spl_mmc_raw_uboot_offset(part)) * 512);
 
 #ifdef CONFIG_SYS_MMCSD_RAW_MODE_U_BOOT_USE_SECTOR
 		ret = mmc_load_image_raw_sector(spl_image, bootdev, mmc,
 						raw_sect +
 						spl_mmc_raw_uboot_offset(part));
+		printf("[SPL] mmc_load_image_raw_sector ret=%d\n", ret);
 		if (!ret)
 			return 0;
 #elif defined(CONFIG_SYS_MMCSD_RAW_MODE_U_BOOT_USE_PARTITION) || \
--- a/common/spl/spl_fit.c
+++ b/common/spl/spl_fit.c
@@ -595,21 +595,7 @@
  */
 __weak void *board_spl_fit_buffer_addr(ulong fit_size, int sectors, int bl_len)
 {
-	void *buf;
-	size_t size = sectors * bl_len;
-
-	buf = malloc_cache_aligned(size);
-	if (!buf) {
-		pr_err("Could not get FIT buffer of %lu bytes\n", (ulong)size);
-
-		if (IS_ENABLED(CONFIG_SPL_SYS_MALLOC))
-			pr_err("\tcheck CONFIG_SPL_SYS_MALLOC_SIZE\n");
-		else
-			pr_err("\tcheck CONFIG_SPL_SYS_MALLOC_F_LEN\n");
-
-		buf = spl_get_load_buffer(0, size);
-	}
-	return buf;
+	return (void *)0x41000000;
 }
 
 /*
@@ -721,16 +707,13 @@
 	 */
 	size = get_aligned_image_size(info, size, 0);
 	buf = board_spl_fit_buffer_addr(size, size, 1);
+	printf("[SPL-FIT] fit_buffer=0x%x, size=%u\n", (unsigned int)(uintptr_t)buf, (unsigned int)size);
 	if (!buf) {
-		/*
-		 * We assume that none of the board will ever use 0x0 as a
-		 * valid load address. Theoretically some board could use it,
-		 * but this is extremely unlikely.
-		 */
 		return -EIO;
 	}
 
 	count = info->read(info, offset, size, buf);
+	printf("[SPL-FIT] info->read count=%u\n", (unsigned int)count);
 	if (!count) {
 		/*
 		 * FIT could not be read. This means we should free the
@@ -804,7 +787,9 @@
 	int index = 0;
 	int firmware_node;
 
+	printf("[SPL-FIT] load_simple_fit starting (off=0x%x)...\n", (unsigned int)offset);
 	ret = spl_simple_fit_read(&ctx, info, offset, fit);
+	printf("[SPL-FIT] simple_fit_read ret=%d\n", ret);
 	if (ret < 0)
 		return ret;
 
