From: Armbian Build Framework <build@armbian.com>
Subject: [PATCH] spl: Add detailed boot progress diagnostics for MMC and stage jump

Print clear progress messages during SPL MMC initialization, block reading,
and image jumping to aid debugging headless / UART boot failures.

---
 common/spl/spl.c     |  3 +++
 common/spl/spl_mmc.c | 16 ++++++++++++++--
 2 files changed, 17 insertions(+), 2 deletions(-)

--- a/common/spl/spl.c
+++ b/common/spl/spl.c
@@ -769,6 +769,8 @@
 	spl_perform_board_fixups(&spl_image);
 
 	os = spl_image.os;
+	printf("[SPL] image loaded: os=%d, size=%lu, entry=0x%lx\n",
+	       os, (unsigned long)spl_image.size, (unsigned long)spl_image.entry_point);
 	if (os == IH_OS_U_BOOT) {
 		debug("Jumping to %s...\n", xpl_name(xpl_next_phase()));
 	} else if (CONFIG_IS_ENABLED(ATF) && os == IH_OS_ARM_TRUSTED_FIRMWARE) {

--- a/common/spl/spl_mmc.c
+++ b/common/spl/spl_mmc.c
@@ -379,12 +379,13 @@
 
 	/* Perform peripheral init only once for an mmc device */
 	mmc_dev = spl_mmc_get_device_index(bootdev->boot_device);
-	log_debug("boot_device=%d, mmc_dev=%d\n", bootdev->boot_device,
-		  mmc_dev);
+	printf("[SPL] mmc dev %d init...\n", mmc_dev);
 	if (!mmc || spl_mmc_get_mmc_devnum(mmc) != mmc_dev) {
 		ret = spl_mmc_find_device(&mmc, mmc_dev);
-		if (ret)
+		if (ret) {
+			printf("[SPL] find_device failed: %d\n", ret);
 			return ret;
+		}
 
 		ret = mmc_init(mmc);
 		if (ret) {
@@ -393,6 +394,8 @@
 			return ret;
 		}
 	}
+	printf("[SPL] mmc init ok: %s (caps=0x%x, clock=%u)\n",
+	       mmc->cfg->name, mmc->cfg->host_caps, mmc->clock);
 
 	boot_mode = spl_mmc_boot_mode(mmc, bootdev->boot_device);
 	ret = -EINVAL;
@@ -422,11 +425,14 @@
 		}
 
 		raw_sect = spl_mmc_get_uboot_raw_sector(mmc, raw_sect);
+		printf("[SPL] loading from raw sector %lu (offset 0x%lx)...\n",
+		       raw_sect, (raw_sect + spl_mmc_raw_uboot_offset(part)) * 512);
 
 #ifdef CONFIG_SYS_MMCSD_RAW_MODE_U_BOOT_USE_SECTOR
 		ret = mmc_load_image_raw_sector(spl_image, bootdev, mmc,
 						raw_sect +
 						spl_mmc_raw_uboot_offset(part));
+		printf("[SPL] mmc_load_image_raw_sector ret=%d\n", ret);
 		if (!ret)
 			return 0;
 #elif defined(CONFIG_SYS_MMCSD_RAW_MODE_U_BOOT_USE_PARTITION) || \
